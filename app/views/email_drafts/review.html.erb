<main class="review-card"><%= link_to "← Back to conversation", conversation_path(@draft.conversation), class: "text-link" %><p class="eyebrow mt-7">REVIEW BEFORE APPROVAL</p><h1 class="text-2xl font-semibold mt-2">The exact saved reply</h1><p class="muted mt-3 mb-6"><%= @draft.conversation.email_provider == "gmail" ? "This is a Gmail reply. After approval, a separate confirmation sends a real email as sales@breezeblock.ca." : "Approval locks this saved version for simulated sending. No real email will be sent." %></p><dl class="review-fields"><dt>From / Reply-To</dt><dd>sales@breezeblock.ca</dd><dt>To</dt><dd><%= @draft.to %></dd><dt>CC</dt><dd><%= @draft.cc.presence || "None" %></dd><dt>Subject</dt><dd><%= @draft.subject %></dd><dt>Delivery</dt><dd><%= @draft.conversation.email_provider == "gmail" ? "Gmail · live after explicit send confirmation" : "Fake email · local simulation" %></dd><dt>Attachments</dt><dd>None</dd></dl><div class="message-body review-body"><%= simple_format(@draft.body) %></div>
  <% if @draft.editable? %><%= button_to "Approve this saved reply", approve_email_draft_path(@draft), params: { lock_version: @draft.lock_version }, class: "btn primary mt-6" %><% else %><p class="demo-note mt-5">This reply is <%= @draft.status %> and cannot be changed.</p><% end %>
</main>
